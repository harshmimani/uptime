{
  "name": "uptime",
  "private": true,
  "type": "module",
  "description": "Uptime training app. No build step; this file only tells Node the js/ files are ES modules and runs the tests.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check:style": "node tests/browser/check-style.mjs",
    "check:workout": "node tests/browser/check-workout.mjs",
    "check:pages": "node tests/browser/check-pages.mjs",
    "check:home": "node tests/browser/check-home.mjs",
    "check:offline": "node tests/browser/check-offline.mjs",
    "make:icons": "node tests/browser/make-icons.mjs",
    "check:nav": "node tests/browser/check-nav.mjs"
  }
}
