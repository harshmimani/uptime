#!/bin/sh
# commit-msg hook: keeps harshmimani as the only author of every commit.
#
# Removes, case-insensitively:
#   - Co-Authored-By lines that name an AI tool or bot (human co-authors are kept)
#   - Claude-Session lines
#   - "Generated with ..." / "Generated by ..." lines (with or without a leading emoji)
#   - any line linking to claude.ai/code
#   - any line containing noreply@anthropic.com
# then drops the separators and blank lines those footers leave behind.
#
# Enabled per clone with:  git config core.hooksPath .githooks
# Plain POSIX sh + awk, so it runs in Git for Windows, GitHub Desktop, macOS and Linux.
# Do not remove or bypass this hook (see CLAUDE.md).

msg_file="$1"
[ -f "$msg_file" ] || exit 0
tmp_file="$msg_file.attribution-tmp"

LC_ALL=C awk '
{
  sub(/\r$/, "")                       # tolerate CRLF messages from Windows editors
  line = $0
  l = tolower(line)

  if (l ~ /noreply@anthropic\.com/) next
  if (l ~ /claude\.ai\/code/) next
  if (l ~ /^[ \t]*claude-session[ \t]*:/) next
  if (l ~ /^[^a-z0-9]*generated[ \t]+(with|by)([^a-z0-9]|$)/) next

  if (l ~ /^[ \t]*co-authored-by[ \t]*:/) {
    ai = 0
    if (l ~ /@(anthropic|openai|cursor|codeium|windsurf|tabnine|cognition|devin)\./) ai = 1
    if (l ~ /\[bot\]/) ai = 1
    if (l ~ /copilot/) ai = 1
    if (l ~ /claude[ \t]+(code|opus|sonnet|haiku|fable|instant|[0-9])/) ai = 1
    if (l ~ /:[ \t]*claude[ \t]*</) ai = 1
    if (l ~ /(chatgpt|gpt-?[0-9]|openai|codex|gemini|bard|codeium|windsurf|tabnine|codewhisperer|amazon q|devin|aider|cursor agent|cursor ai|sweep ai)/) ai = 1
    if (ai) next
  }

  lines[++n] = line
}
END {
  # Peel the tail: keep git comment lines, drop blanks and footer separators.
  m = 0
  while (n > 0) {
    t = lines[n]
    if (t ~ /^#/) { tail[++m] = t; n--; continue }
    if (t ~ /^[ \t]*$/ || t ~ /^[ \t]*(---+|___+|\*\*\*+)[ \t]*$/) { n--; continue }
    break
  }
  prev_blank = 1
  for (i = 1; i <= n; i++) {
    blank = (lines[i] ~ /^[ \t]*$/)
    if (blank && prev_blank) continue
    print lines[i]
    prev_blank = blank
  }
  if (m > 0) { print ""; for (i = m; i >= 1; i--) print tail[i] }
}
' "$msg_file" > "$tmp_file" || { rm -f "$tmp_file"; exit 1; }

mv "$tmp_file" "$msg_file"

if ! grep -q '^[^#]*[^[:space:]]' "$msg_file"; then
  echo "commit-msg: the message is empty after removing AI attribution." >&2
  exit 1
fi
exit 0
